# GOAT backend local environment template
# 실제 키는 이 파일에 넣지 말고, 이 파일을 복사한 .env 파일에만 넣으세요.

# OpenRouter LLM API
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# 한국관광콘텐츠랩 OpenAPI / 국문 관광정보 서비스_GW
VISITKOREA_SERVICE_KEY=
VISITKOREA_MOBILE_OS=ETC
VISITKOREA_MOBILE_APP=GOAT

# Kakao Map
# StaticMap은 프론트에서 Kakao JavaScript SDK로 렌더링하는 구조입니다.
KAKAO_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=
