{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:place-catalog": "tsx ./scripts/seed-place-catalog.ts",
    "verify": "pnpm exec tsx ./scripts/verify-recommendation-contract.ts && node ./scripts/verify-api.mjs && node ./scripts/verify-recommendation-audit.mjs && node ./scripts/verify-persistence-contract.mjs",
    "verify:live": "node ./scripts/verify-live-recommendation-persistence.mjs",
    "verify:live-kto": "node ./scripts/verify-kto-live.mjs",
    "verify:live-kto-local": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-kto-live-local.ps1"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/travel-domain": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
