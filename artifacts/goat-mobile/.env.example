# Used when the frontend is started separately. `pnpm dev:web` sets this itself.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# A physical device must use the development computer's LAN address instead:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3000
EXPO_PUBLIC_KTO_MOBILE_OS=
EXPO_PUBLIC_KTO_MOBILE_APP=
