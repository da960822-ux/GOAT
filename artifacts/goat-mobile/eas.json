{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://goat-api-lac.vercel.app"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "ios": {
        "simulator": false
      }
    },
    "onestore": {
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://goat-api-lac.vercel.app"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://goat-api-lac.vercel.app"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      }
    }
  }
}
